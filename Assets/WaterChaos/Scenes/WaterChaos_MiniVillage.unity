--- !u!114 &1187617060
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1187617058}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aed6527f3805a41e99d82a49bd6c5b02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WaterChaos.Mission.StoryStep
  _optional: 0
  _started:
    m_PersistentCalls:
      m_Calls: []
  _completed:
    m_PersistentCalls:
      m_Calls: []
  _speaker: 
  _text: "\u0427\u0443\u0434\u043E\u0432\u043E, \u0437 \u0431\u0443\u0434\u0438\u043D\u043A\u043E\u043C \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u043B\u0438\u0441\u044F. \u0410\u043B\u0435 \u044F\u043A \u0442\u0435\u043F\u0435\u0440 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0456\u0432?\n\n\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u044F\u043A\u043E\u0441\u044C \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438 \u0446\u044E \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0443 \u043E\u0433\u043E\u0440\u043E\u0436\u0443. \u041F\u043E\u043A\u0438 \u044F \u0457\u0445\u0430\u0432 \u0441\u044E\u0434\u0438, \u043F\u043E\u043C\u0456\u0442\u0438\u0432 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0456\u043A \u0437\u0430\u0432\u043E\u0434. \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u0430\u043C \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u044C\u0441\u044F \u0449\u043E\u0441\u044C, \u0449\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0440\u043E\u0437\u0447\u0438\u043D\u0438\u0442\u0438 \u043C\u0435\u0442\u0430\u043B."
