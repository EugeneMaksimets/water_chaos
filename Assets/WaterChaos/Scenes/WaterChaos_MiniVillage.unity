--- !u!114 &223300432
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 223300430}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aed6527f3805a41e99d82a49bd6c5b02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WaterChaos.Mission.StoryStep
  _optional: 0
  _started:
    m_PersistentCalls:
      m_Calls: []
  _completed:
    m_PersistentCalls:
      m_Calls: []
  _speaker: 
  _text: "\u0422\u0438 \u043F\u0440\u0438\u0457\u0445\u0430\u0432 \u043D\u0430 \u0432\u0438\u043A\u043B\u0438\u043A, \u0449\u043E\u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0441\u0432\u043E\u0457\u043C \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430\u043C. \u0410\u043B\u0435, \u0441\u0445\u043E\u0436\u0435, \u0442\u0438 \u0437\u0430\u0457\u0445\u0430\u0432 \u043D\u0435 \u0437 \u0442\u043E\u0433\u043E \u0431\u043E\u043A\u0443 \u2014 \u043F\u0440\u043E\u0457\u0437\u0434\u0443 \u0434\u0430\u043B\u0456 \u043D\u0435\u043C\u0430\u0454.\n\n\u041F\u043E\u043A\u0438 \u0449\u043E \u0434\u0430\u0432\u0430\u0439 \u0437\u0430\u0433\u0430\u0441\u0438\u043C\u043E \u0431\u0443\u0434\u0438\u043D\u043E\u043A \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u044E, \u0430 \u043F\u043E\u0442\u0456\u043C \u043F\u043E\u0434\u0443\u043C\u0430\u0454\u043C\u043E, \u044F\u043A \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0442\u0432\u043E\u0457\u0445 \u0434\u0440\u0443\u0437\u0456\u0432."
