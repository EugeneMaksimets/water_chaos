  _speaker: "\u041D\u0430\u043F\u0430\u0440\u043D\u0438\u043A"
  _text: "\u0422\u0438 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0432 \u043A\u043E\u0442\u0438\u043A\u0430! \u0412\u0456\u043D \u0442\u0440\u043E\u0445\u0438 \u043D\u0430\u043B\u044F\u043A\u0430\u043D\u0438\u0439, \u0430\u043B\u0435 \u0436\u0438\u0432\u0438\u0439 \u0456 \u0446\u0456\u043B\u0438\u0439.\n\n\u0412\u0438\u043F\u0430\u0440\u0438 \u0432\u0436\u0435 \u0440\u043E\u0437\u0432\u0456\u044E\u044E\u0442\u044C\u0441\u044F. \u0422\u0435\u043F\u0435\u0440 \u043A\u0438\u043D\u044C \u043C\u0438\u043B\u043E \u0432 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0439 \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440 \u2014 \u043C\u0438\u043B\u044C\u043D\u0430 \u0432\u043E\u0434\u0430 \u043D\u0430\u043C \u0449\u0435 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F."
