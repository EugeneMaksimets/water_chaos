  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WaterChaos.Mission.StoryStep
  _optional: 0
  _started:
    m_PersistentCalls:
      m_Calls: []
  _completed:
    m_PersistentCalls:
      m_Calls: []
  _speaker: "\u041D\u0430\u043F\u0430\u0440\u043D\u0438\u043A"
  _text: "\u0421\u0442\u0440\u0438\u0432\u0430\u0439! \u0412\u0456\u0434 \u0440\u0435\u0430\u043A\u0446\u0456\u0457 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0457 \u0432\u043E\u0434\u0438 \u0437 \u0431\u0435\u043D\u0437\u0438\u043D\u043E\u043C \u043D\u0430\u0448 \u0431\u0443\u0434\u0438\u043D\u043E\u043A \u043D\u0430\u043F\u043E\u0432\u043D\u0438\u0432\u0441\u044F \u043E\u0442\u0440\u0443\u0439\u043D\u0438\u043C\u0438 \u0432\u0438\u043F\u0430\u0440\u0430\u043C\u0438\u2026 \u0410 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F \u043A\u043E\u0442\u0438\u043A!\n\n\u0411\u0435\u0437 \u043F\u0440\u043E\u0442\u0438\u0433\u0430\u0437\u0443 \u0442\u0443\u0434\u0438 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u2014 \u0432\u0438\u043F\u0430\u0440\u0438 \u043E\u0434\u0440\u0430\u0437\u0443 \u0432\u0438\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0442\u044C \u0442\u0435\u0431\u0435 \u043D\u0430\u0437\u043E\u0432\u043D\u0456. \u041F\u0440\u043E\u0442\u0438\u0433\u0430\u0437 \u043B\u0435\u0436\u0438\u0442\u044C \u0431\u0456\u043B\u044F \u043D\u0430\u0441: \u0432\u0456\u0437\u044C\u043C\u0438 \u0439\u043E\u0433\u043E, \u043D\u0430\u0434\u0456\u043D\u044C, \u0437\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0442\u0438\u043A\u0430 \u0439 \u0432\u0438\u043D\u0435\u0441\u0438 \u043D\u0430 \u0432\u0443\u043B\u0438\u0446\u044E. \u041F\u0440\u0438\u0441\u043B\u0443\u0445\u0430\u0439\u0441\u044F \u2014 \u0432\u0456\u043D \u043D\u044F\u0432\u043A\u0430\u0454!"
